{
  "name": "minecraft-server-panel",
  "version": "0.0.1",
  "description": "一个用于管理Minecraft服务器的现代化面板",
  "main": "index.js",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:client-server\" \"npm run dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:client-server": "cd client/server && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "concurrently \"npm run build:client\" \"npm run build:client-server\" \"npm run build:server\"",
    "build:client": "cd client && npm run build",
    "build:client-server": "cd client/server && npm run build",
    "build:server": "cd server && npm run build",
    "start": "concurrently \"npm run start:client\" \"npm run start:client-server\" \"npm run start:server\"",
    "start:client": "cd client && npm run preview",
    "start:client-server": "cd client/server && npm start",
    "start:server": "cd server && npm start",
    "package:all-in-one": "node scripts/package-all-in-one.js",
    "package:separate": "node scripts/package-separate.js"
  },
  "keywords": ["minecraft", "server", "panel"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.4.2",
    "concurrently": "^8.2.0"
  }
}